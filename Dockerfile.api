FROM mcr.microsoft.com/dotnet/sdk:10.0.201 AS build
WORKDIR /source
COPY . .
RUN dotnet restore src/Orbit.Api/Orbit.Api.csproj
RUN dotnet publish src/Orbit.Api/Orbit.Api.csproj --no-restore -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["sh", "-c", "ASPNETCORE_URLS=http://0.0.0.0:${PORT:-8080} exec dotnet Orbit.Api.dll"]
